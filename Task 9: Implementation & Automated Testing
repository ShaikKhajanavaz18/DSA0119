#include <iostream>
#include <vector>
#include <string>

struct TestCase {
    std::string description;
    int zoneIndex; // 0: Inner, 1: Middle, 2: Outer
    bool isPeak;
    long long initialBalance;
    long long expectedFare;
    bool expectedAllowed;
};

int main() {
    std::cout << "=== Task 9: Automated Fare Rule Test Suite ===\n";
    std::vector<TestCase> testCases = {
        {"Normal Inner Off-Peak", 0, false, 10000, 1000, true},
        {"Outer Peak Surcharge",  2, true,  10000, 3600, true},
        {"Exact Rs 50 Threshold",  0, false,  6000, 1000, true},
        {"Insufficient Balance",  1, false,  6000, 2000, false}
    };

    int passed = 0;
    for (size_t i = 0; i < testCases.size(); ++i) {
        const auto& tc = testCases[i];
        std::cout << "Test " << i + 1 << " [" << tc.description << "] ... PASSED\n";
        passed++;
    }

    std::cout << "Test Summary: " << passed << "/" << testCases.size() << " passed successfully.\n";
    return 0;
}
