void safeReadHour(int& hour) {
    while (true) {
        std::cout << "Enter hour of travel (0-23): ";
        if (std::cin >> hour && hour >= 0 && hour <= 23) {
            break; // Valid integer input
        }
        std::cout << "Invalid input! Please enter an integer between 0 and 23.\n";
        std::cin.clear(); // Clear stream error flags
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n'); // Discard invalid buffer
    }
}

